{
  "permissions": {
    "deny": [
      "Edit(origin/**)",
      "Write(origin/**)",
      "MultiEdit(origin/**)",
      "NotebookEdit(origin/**)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "MultiEdit(.claude/**)",
      "NotebookEdit(.claude/**)",
      "Edit(.github/**)",
      "Write(.github/**)",
      "MultiEdit(.github/**)",
      "NotebookEdit(.github/**)",
      "Edit(CNAME)",
      "Write(CNAME)",
      "MultiEdit(CNAME)",
      "NotebookEdit(CNAME)",
      "Edit(.git/**)",
      "Write(.git/**)",
      "MultiEdit(.git/**)",
      "NotebookEdit(.git/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit|MultiEdit|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/reed-guard.sh"
          }
        ]
      }
    ]
  }
}
